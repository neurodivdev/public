---
// Kanonische App-Link-URL (siehe public/.well-known). Muss eine echte Seite mit Status 200 bleiben,
// damit Link-Vorschauen funktionieren; leitet im Browser samt #Code auf die Sprachversion weiter.
import { ui, defaultLang } from '../../../i18n/ui';
import socialPreview from '../../../assets/2048/social_media_preview.png';

const supportedLangs = Object.keys(ui);
const t = ui[defaultLang];
const socialImageUrl = new URL(socialPreview.src, Astro.site);
---
<!DOCTYPE html>
<html lang={defaultLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>{t['plus2048.challenge_pageTitle']}</title>
  <meta name="description" content={t['plus2048.challenge_pageDesc']}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={t['plus2048.challenge_pageTitle']}>
  <meta property="og:description" content={t['plus2048.challenge_pageDesc']}>
  <meta property="og:image" content={socialImageUrl}>
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:image" content={socialImageUrl}>

  <script is:inline define:vars={{ supportedLangs, defaultLang }}>
    const browserLang = (navigator.language || navigator.userLanguage || '').split('-')[0];
    const targetLang = supportedLangs.includes(browserLang) ? browserLang : defaultLang;
    window.location.replace('/' + targetLang + '/2048/c/' + window.location.hash);
  </script>

  <style>
    body {
      background-color: #1A1A2E;
      margin: 0;
    }
    @media (prefers-color-scheme: light) {
      body {
        background-color: #FAFAFA;
      }
    }
  </style>
</head>
<body>
</body>
</html>
