---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageDocument from '../../../components/PageDocument.astro';
import FeatureSection from '../../../components/FeatureSection.astro';
import HeroBanner from '../../../components/HeroBanner.astro';
import CtaSection from '../../../components/CtaSection.astro';
import FaqSection from '../../../components/FaqSection.astro';
import {getLangFromUrl, getStaticPathsFromUi, useTranslations} from '../../../i18n/utils';
import headerImg from '../../../assets/yurua/header.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return getStaticPathsFromUi();
}

const backUrl = `/${lang}/`;
---

<BaseLayout
    title={t('yurua.pageTitle')}
    description={t('yurua.pageDesc')}
    backUrl={backUrl}
>
  <HeroBanner imgSrc={headerImg} imgAlt={t('yurua.heroImgAlt')} />

  <PageDocument title={t('yurua.title')}>
    <p set:html={t('yurua.intro')} />
  </PageDocument>

  <FeatureSection title={t('yurua.h2_1')} intro={t('yurua.p_1')}>
    <ul class="custom-list">
      <li set:html={t('yurua.li_1_1')} />
      <li set:html={t('yurua.li_1_2')} />
      <li set:html={t('yurua.li_1_3')} />
    </ul>
  </FeatureSection>

  <FeatureSection title={t('yurua.h2_2')} intro={t('yurua.p_2')}>
    <ul class="custom-list">
      <li set:html={t('yurua.li_2_1')} />
      <li set:html={t('yurua.li_2_2')} />
      <li set:html={t('yurua.li_2_3')} />
      <li set:html={t('yurua.li_2_4')} />
    </ul>
  </FeatureSection>

  <FeatureSection title={t('yurua.h2_3')}>
    <p set:html={t('yurua.p_3')} />
  </FeatureSection>

  <FeatureSection title={t('yurua.h2_4')}>
    <ul class="custom-list">
      <li set:html={t('yurua.li_4_1')} />
      <li set:html={t('yurua.li_4_2')} />
      <li set:html={t('yurua.li_4_3')} />
      <li set:html={t('yurua.li_4_4')} />
    </ul>
  </FeatureSection>

  <FeatureSection title={t('yurua.h2_5')}>
    <p set:html={t('yurua.p_5')} />
  </FeatureSection>

  <CtaSection
      title={t('yurua.ctaTitle')}
      description={t('yurua.ctaDesc')}
      playStoreLink="https://play.google.com/store/apps/details?id=dev.neurodiv.yurua"
      appStoreLink={t('yurua.appStoreLink')}
  />

  <FaqSection
      title={t('yurua.faq_title')}
      prefix="yurua.faq_"
  />
</BaseLayout>
