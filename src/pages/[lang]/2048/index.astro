---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageDocument from '../../../components/PageDocument.astro';
import FeatureSection from '../../../components/FeatureSection.astro';
import HeroBanner from '../../../components/HeroBanner.astro';
import CtaSection from '../../../components/CtaSection.astro';
import FaqSection from '../../../components/FaqSection.astro';
import {getLangFromUrl, getStaticPathsFromUi, useTranslations} from '../../../i18n/utils';
import defaultHeaderImg from '../../../assets/2048/header.png';
import germanHeaderImg from '../../../assets/2048/header-de.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return getStaticPathsFromUi();
}

const backUrl = `/${lang}/`;
const headerImg = lang === 'de' ? germanHeaderImg : defaultHeaderImg;
---

<BaseLayout
    title={t('plus2048.pageTitle')}
    description={t('plus2048.pageDesc')}
    backUrl={backUrl}
>
  <HeroBanner imgSrc={headerImg} imgAlt={t('plus2048.heroImgAlt')} />

  <PageDocument title={t('plus2048.title')}>
    <p set:html={t('plus2048.intro')} />
  </PageDocument>

  <FeatureSection title={t('plus2048.h2_1')} intro={t('plus2048.p_1')}>
    <ul class="custom-list">
      <li set:html={t('plus2048.li_1_1')} />
      <li set:html={t('plus2048.li_1_2')} />
      <li set:html={t('plus2048.li_1_3')} />
      <li set:html={t('plus2048.li_1_4')} />
      <li set:html={t('plus2048.li_1_5')} />
    </ul>
  </FeatureSection>

  <FeatureSection title={t('plus2048.h2_2')}>
    <ul class="custom-list">
      <li set:html={t('plus2048.li_2_1')} />
      <li set:html={t('plus2048.li_2_2')} />
      <li set:html={t('plus2048.li_2_3')} />
      <li set:html={t('plus2048.li_2_4')} />
    </ul>
  </FeatureSection>

  <FeatureSection title={t('plus2048.h2_3')}>
    <p set:html={t('plus2048.p_3')} />
  </FeatureSection>

  <FeatureSection title={t('plus2048.h2_4')} intro={t('plus2048.p_4')}>
    <ul class="custom-list">
      <li set:html={t('plus2048.li_4_1')} />
      <li set:html={t('plus2048.li_4_2')} />
      <li set:html={t('plus2048.li_4_3')} />
      <li set:html={t('plus2048.li_4_4')} />
      <li set:html={t('plus2048.li_4_5')} />
    </ul>
  </FeatureSection>

  <CtaSection
      title={t('plus2048.ctaTitle')}
      description={t('plus2048.ctaDesc')}
      playStoreLink="https://play.google.com/store/apps/details?id=dev.neurodiv.plus2048"
      appStoreLink={t('plus2048.appStoreLink')}
  />

  <FaqSection
      title={t('plus2048.faq_title')}
      prefix="plus2048.faq_"
  />
</BaseLayout>
