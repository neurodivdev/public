---
import { Image } from 'astro:assets';
import { imageQuality } from './imageQuality';

export interface Props {
  href: string;
  title: string;
  description: string;
  dateText: string;
  isDraft: boolean;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { href, title, description, dateText, isDraft, cover, coverAlt } = Astro.props;
---
<a href={href} class="blog-card">
  {cover && <Image src={cover} alt={coverAlt ?? ''} quality={imageQuality} class="blog-card-img" />}
  <div class="blog-card-content">
    <p class="blog-card-date">{dateText}{isDraft && <span class="blog-card-draft">Draft</span>}</p>
    <h2 class="blog-card-title">{title}</h2>
    <p class="blog-card-desc">{description}</p>
  </div>
</a>

<style>
  .blog-card {
    background-color: var(--card-bg);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 20px rgba(0,0,0,0.08);
    transition: transform 0.3s ease;
    text-decoration: none;
    color: inherit;
  }
  .blog-card:hover {
    transform: translateY(-5px);
  }
  .blog-card-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-bottom: 1px solid var(--border-color);
  }
  .blog-card-content {
    padding: 25px 30px;
  }
  .blog-card-date {
    margin: 0 0 8px 0;
    font-size: 0.9em;
    color: var(--text-muted);
  }
  .blog-card-draft {
    margin-left: 10px;
    padding: 2px 10px;
    border-radius: 50px;
    border: 1px solid var(--accent-secondary);
    color: var(--accent-secondary);
    font-weight: bold;
  }
  .blog-card-title {
    font-size: 1.5em;
    line-height: 1.3;
    margin: 0 0 10px 0;
    color: var(--accent-primary);
  }
  .blog-card-desc {
    margin: 0;
    font-size: 1.05em;
  }
</style>
